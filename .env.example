# ---- Server-only (used by scripts/setup-appwrite.mjs, never shipped to the browser) ----
# Get this from the Appwrite console: Project Settings > API Keys.
# Needs scopes: databases.write, collections.write, attributes.write, indexes.write,
# buckets.write, files.write, teams.write, users.read
# NEVER prefix these with REACT_APP_ — react-scripts inlines anything with that
# prefix straight into the public JS bundle.
APPWRITE_API_KEY=
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6996beb90002219bff63
APPWRITE_DATABASE_ID=6996bfd50005e4ecb093
BLOG_COLLECTION_ID=blogs
BLOG_BUCKET_ID=blog_images
BLOG_TEAM_ID=bloggers

# The email of the already-registered Appwrite account (same login used in the
# SajhaSwayamsewak app) that should be allowed to write/edit blog posts.
# That account must have logged in at least once before running the setup
# script, so it exists in Appwrite's Users list.
BLOGGER_EMAIL=

# ---- Public (safe to expose — bundled into the browser build) ----
REACT_APP_APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
REACT_APP_APPWRITE_PROJECT_ID=6996beb90002219bff63
REACT_APP_APPWRITE_DATABASE_ID=6996bfd50005e4ecb093
REACT_APP_BLOG_COLLECTION_ID=blogs
REACT_APP_BLOG_BUCKET_ID=blog_images
REACT_APP_BLOG_TEAM_ID=bloggers
